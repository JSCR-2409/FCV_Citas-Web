#!/usr/bin/env bash
# Puerta de calidad local de citas-web. Se activa con:
#   git config core.hooksPath .githooks
#
# Bloquea el commit si:
#   1. el contenido preparado contiene credenciales o patrones de secreto;
#   2. no compila el chequeo de tipos;
#   3. el lint falla;
#   4. las pruebas no pasan.
#
# Se ejecuta dentro del contenedor fcv-citas-web-dev cuando esta disponible, porque alli viven
# las dependencias instaladas. Si no hay forma de ejecutar las verificaciones, el hook bloquea
# en lugar de dar por bueno lo que no pudo comprobar.

set -uo pipefail

REPO_ROOT="$(git rev-parse --show-toplevel)"
cd "$REPO_ROOT" || exit 1

CONTAINER="fcv-citas-web-dev"

echo "== Verificacion previa al commit (citas-web) =="

echo "-- 1/4 Buscando credenciales en el contenido preparado"
if ! bash .githooks/secret-scan.sh --staged; then
  echo ""
  echo "COMMIT BLOQUEADO: se detectaron posibles secretos."
  exit 1
fi
echo "   OK: sin credenciales detectadas."

if command -v docker >/dev/null 2>&1 && docker ps --format '{{.Names}}' 2>/dev/null | grep -qx "$CONTAINER"; then
  run() { docker exec -i "$CONTAINER" "$@"; }
  echo "   Usando el contenedor $CONTAINER"
elif command -v npm >/dev/null 2>&1 && [ -d node_modules ]; then
  run() { "$@"; }
  echo "   Usando el Node del host"
else
  echo ""
  echo "COMMIT BLOQUEADO: no se pudieron ejecutar las verificaciones."
  echo "  Levante el entorno con  docker compose up -d  desde la raiz del workspace,"
  echo "  o instale las dependencias con  npm ci  en el host."
  exit 1
fi

echo "-- 2/4 Chequeo de tipos"
if ! run npm run --silent typecheck; then
  echo ""
  echo "COMMIT BLOQUEADO: el chequeo de tipos falla."
  exit 1
fi
echo "   OK."

echo "-- 3/4 Lint"
if ! run npm run --silent lint; then
  echo ""
  echo "COMMIT BLOQUEADO: el lint falla."
  exit 1
fi
echo "   OK."

echo "-- 4/4 Pruebas"
if ! run npx ng test --watch=false; then
  echo ""
  echo "COMMIT BLOQUEADO: hay pruebas en rojo."
  exit 1
fi
echo "   OK."

echo "== Verificacion superada =="
exit 0
